# Copy to .env.local for local development. Never commit real values.
# Supabase (database + logins). Leave empty until the Supabase project exists;
# the site still runs, and booking/interest forms say they are not connected yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email sending (optional). Without it, emails are saved to the admin "Sent emails" log only.
RESEND_API_KEY=
EMAIL_FROM="Everkind <hello@everkind.example>"

# Public site address, used in emails and page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
