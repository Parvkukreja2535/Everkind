// Generates supabase/migrations/0003_seed_catalogue.sql from src/lib/catalogue.ts.
// Run: node --experimental-strip-types scripts/generate-catalogue-seed.mts
import { writeFileSync } from "node:fs";
import { CATEGORIES, SERVICES, INSTANT_CLEAN_HOURS } from "../src/lib/catalogue.ts";

const DURATION: Record<string, number> = {
  "short-let-turnover-studio": 120, "short-let-turnover-1-bedroom": 150, "short-let-turnover-2-bedroom": 180, "short-let-turnover-3-bedroom": 210,
  "womens-haircut-trim": 60, "blow-dry-styling": 45, manicure: 45, "mens-haircut": 45, "haircut-and-beard-trim": 60,
  "picture-mirror-shelf-hanging": 60, "curtain-rail-blind-installation": 90,
};

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number") return String(v);
  if (typeof v === "boolean") return v ? "true" : "false";
  return `'${String(v).replace(/'/g, "''")}'`;
};
const arr = (a: string[] | undefined) => (a && a.length ? `array[${a.map(q).join(", ")}]::text[]` : "'{}'::text[]");
const nums = (a: number[] | null) => (a ? `array[${a.join(", ")}]::numeric[]` : "null");

let sql = `-- Everkind 0003: seed the catalogue from the business-model workbook (generated by scripts/generate-catalogue-seed.mts).
-- 14 categories and 44 services; Flat-pack furniture assembly (workbook row 26) is an option inside Furniture assembly.
-- "on conflict do nothing": re-running never overwrites changes made in the admin dashboard.

`;
CATEGORIES.forEach((c, i) => {
  sql += `insert into categories (slug, name, workbook_name, description, sort_order) values (${q(c.slug)}, ${q(c.name)}, ${q(c.workbookName)}, ${q(c.description)}, ${i * 10}) on conflict (slug) do nothing;\n`;
});
sql += "\n";
const listed = SERVICES.filter((s) => !s.optionOf);
listed.forEach((s, i) => {
  const instant = s.slug === "instant-clean";
  const minHours = instant ? 1 : s.priceType === "hourly" ? (s.slug === "regular-domestic-cleaning" ? 2 : 1) : s.options ? 1 : null;
  const hoursOptions = instant ? INSTANT_CLEAN_HOURS : s.options ? [1, 2, 3, 4] : null;
  const duration = instant ? 60 : DURATION[s.slug] ?? 60;
  sql += `insert into services (slug, category_id, name, summary, included, excluded, checks, image_url, availability, workforce, workbook_row, workbook_phase, everkind_addition, keywords, price_type, price_pence, price_note, min_hours, hours_options, duration_minutes, sort_order)
select ${q(s.slug)}, c.id, ${q(s.name)}, ${q(s.summary)}, ${arr(s.included)}, ${arr(s.excluded)}, ${q(s.checks)}, ${q(s.image)}, ${q(s.availability)}::service_availability, ${q(s.workforce)}::workforce, ${s.workbookRow}, ${q(s.workbookPhase)}, ${q(!!s.everkindAddition)}, ${arr(s.keywords)}, ${q(s.priceType)}::price_type, ${q(s.pricePence)}, ${q(s.priceNote)}, ${q(minHours)}, ${nums(hoursOptions)}, ${duration}, ${i * 10}
from categories c where c.slug = ${q(s.category)} on conflict (slug) do nothing;\n`;
  (s.options ?? []).forEach((o, j) => {
    sql += `insert into service_options (service_id, slug, name, description, workbook_row, price_type, price_pence, price_note, min_hours, sort_order)
select s.id, ${q(o.slug)}, ${q(o.name)}, ${q(o.description)}, ${o.workbookRow}, ${q(o.priceType)}::price_type, ${o.pricePence}, ${q(o.priceNote)}, ${o.priceType === "hourly" ? 1 : "null"}, ${j * 10}
from services s where s.slug = ${q(s.slug)} on conflict (service_id, slug) do nothing;\n`;
  });
});
writeFileSync(new URL("../supabase/migrations/0003_seed_catalogue.sql", import.meta.url), sql);
console.log(`categories=${CATEGORIES.length} services=${listed.length} options=${listed.reduce((n, s) => n + (s.options?.length ?? 0), 0)}`);
